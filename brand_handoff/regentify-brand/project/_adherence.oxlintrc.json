{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/reggie/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|pro|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'pro' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|interactive|pad|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: selected, interactive, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|children|key|ref|className|style|children)$/]",
        "message": "<ChoiceButton> doesn't accept that prop. Declared props: label, state, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|correct|wrong|dim)$/]",
        "message": "<ChoiceButton> state must be one of 'idle' | 'correct' | 'wrong' | 'dim'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LessonNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|icon|label|color|size|key|ref|className|style|children)$/]",
        "message": "<LessonNode> doesn't accept that prop. Declared props: state, icon, label, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='LessonNode'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|active|locked)$/]",
        "message": "<LessonNode> state must be one of 'done' | 'active' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|showMeta|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, count, showMeta, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reggie'] > JSXAttribute > JSXIdentifier[name!=/^(?:pose|size|className|style|title|key|ref|className|style|children)$/]",
        "message": "<Reggie> doesn't accept that prop. Declared props: pose, size, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reggie'] > JSXAttribute[name.name='pose'] > Literal[value!=/^(?:happy|cheer|think|sleepy|wave)$/]",
        "message": "<Reggie> pose must be one of 'happy' | 'cheer' | 'think' | 'sleepy' | 'wave'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|icon|color|solid|key|ref|className|style|children)$/]",
        "message": "<StatChip> doesn't accept that prop. Declared props: kind, value, icon, color, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:xp|streak|lives|pro|info)$/]",
        "message": "<StatChip> kind must be one of 'xp' | 'streak' | 'lives' | 'pro' | 'info'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
