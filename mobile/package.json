{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.1",
    "expo-location": "~18.0.10",
    "expo-notifications": "^0.29.14",
    "expo-sharing": "~13.0.0",
    "expo-splash-screen": "^0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-tracking-transparency": "~5.1.1",
    "expo-web-browser": "~14.0.0",
    "firebase": "^12.13.0",
    "lottie-react-native": "7.1.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-purchases": "^10.3.0",
    "react-native-purchases-ui": "^10.3.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "~15.8.0",
    "react-native-view-shot": "~4.0.0",
    "react-native-web": "~0.19.13",
    "rive-react-native": "^9.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "babel-preset-expo": "~12.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.6",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^18.3.1",
    "test-renderer": "^1.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lottie-react-native)"
    ],
    "moduleNameMapper": {
      "^@content/(.*)$": "<rootDir>/../shared/content/$1",
      "^../firebase$": "<rootDir>/src/__mocks__/firebase.js",
      "^../../firebase$": "<rootDir>/src/__mocks__/firebase.js"
    }
  },
  "private": true
}
