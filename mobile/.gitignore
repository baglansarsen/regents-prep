# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# NOTE: /ios is deliberately NOT ignored — this project commits the native iOS
# project (Xcode Cloud builds it, and app.json plugins/infoPlist are therefore
# ignored). Generated paths inside it are covered by mobile/ios/.gitignore
# (build/, Pods/, xcuserdata, DerivedData, .xcode.env.local).
/android

# Android build outputs
*.aab
*.apk

# Firebase credentials (added via EAS secrets or local only)
# google-services.json
# GoogleService-Info.plist

# Google Play service account key — never commit
regapp-c3e0d-b147688ce5b5.json
