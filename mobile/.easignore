# Replicates .gitignore but allows EAS CLI to package google-services.json and GoogleService-Info.plist for the build

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (regenerated by EAS prebuild). Use the trailing-slash
# form — EAS's ignore matcher does not reliably honor the leading-slash form.
ios/
android/

# Android build outputs
*.aab
*.apk
