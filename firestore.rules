rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard — anyone authenticated can read; only owner can write
    match /leaderboard/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Friend requests — sender creates, either party can read/update/delete
    match /friendRequests/{requestId} {
      allow read:   if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow delete: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
    }

    // Challenges — sender creates, either party can read/update
    match /challenges/{challengeId} {
      allow read:   if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
    }

    // Friend code lookup table — anyone auth'd can read; only owner can write their entry
    match /friendCodes/{code} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Mobile Beta signups — anyone authenticated can read and write
    match /mobileBetaSignups/{docId} {
      allow read, write: if request.auth != null;
    }

    // Question reports — anyone authenticated can read and write
    match /reportedQuestions/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
