rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // True if the requesting user is the teacher of the classroom that
    // student `studentUid` belongs to. Uses two cached get() calls.
    function isTeacherOfStudent(teacherUid, studentUid) {
      let student = get(/databases/$(database)/documents/users/$(studentUid)).data;
      let classId = student.get('classId', null);
      return classId != null &&
        get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == teacherUid;
    }

    // True if the requesting user is the teacher of a given classroom.
    function isTeacher(classId) {
      return get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherUid == request.auth.uid;
    }

    // ── User documents ────────────────────────────────────────────────────────
    // Own data: full read/write as before.
    // Teacher read: powers the dashboard — teacher can read any sub-doc
    // (streak, weeklyXP, xp) for students in their classroom.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read:        if request.auth != null && isTeacherOfStudent(request.auth.uid, userId);

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read:        if request.auth != null && isTeacherOfStudent(request.auth.uid, userId);
      }

      // Friends subcollection — owner has full access (covered above); in
      // addition, ANOTHER authenticated user may add or remove ONLY their own
      // entry (docId must equal their uid). This is required for the reciprocal
      // write when accepting a friend request: the accepter writes
      // users/{requesterUid}/friends/{accepterUid}, which the generic rule
      // above would otherwise deny.
      match /friends/{friendId} {
        allow create, delete: if request.auth != null && request.auth.uid == friendId;
      }

      // Public profile stats — any authenticated user may READ a friend's
      // RP, weekly RP, streak, and pet so the friends list can show their
      // stats. Writes remain owner-only (covered by the generic rule above).
      // Other meta docs (settings, private data) stay owner/teacher-only.
      match /meta/{docId} {
        allow read: if request.auth != null &&
                       (docId == 'xp' || docId == 'weeklyXP' ||
                        docId == 'streak' || docId == 'pet');
      }
    }

    // ── Classrooms ────────────────────────────────────────────────────────────
    match /classrooms/{classId} {
      // Any auth'd user can read the classroom doc — needed to show the
      // join confirmation screen before a student commits.
      allow read:   if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.teacherUid == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.teacherUid == request.auth.uid;
      allow delete: if request.auth != null &&
                       resource.data.teacherUid == request.auth.uid;

      // Members sub-collection
      match /members/{memberId} {
        // Teacher sees all; student sees their own.
        allow read:         if request.auth != null &&
                               (request.auth.uid == memberId || isTeacher(classId));
        // Students join (create) and leave (delete) their own entry only.
        allow create, delete: if request.auth != null && request.auth.uid == memberId;
        allow update:         if false;
      }
    }

    // ── Join code lookup — mirrors friendCodes pattern ────────────────────────
    match /joinCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.teacherUid == request.auth.uid;
      allow delete: if request.auth != null &&
                       resource.data.teacherUid == request.auth.uid;
      allow update: if false;
    }

    // ── Leaderboard ───────────────────────────────────────────────────────────
    match /leaderboard/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Friend requests ───────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      allow read:   if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow delete: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
    }

    // ── Challenges ────────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read:   if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid   == request.auth.uid);
    }

    // ── Friend code lookup ────────────────────────────────────────────────────
    match /friendCodes/{code} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Mobile Beta signups — anyone authenticated can read and write
    match /mobileBetaSignups/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Product analytics events — client create-only, never readable ────────
    // Read via Firebase console / Admin SDK only.
    match /events/{eventId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Question reports — anyone authenticated can read and write
    match /reportedQuestions/{docId} {
      allow read, write: if request.auth != null;
    }

    // B2B Classrooms
    match /classrooms/{classCode} {
      allow read, write: if request.auth != null;
    }

    // B2B Assignments
    match /assignments/{assignmentId} {
      allow read, write: if request.auth != null;
    }
  }
}
